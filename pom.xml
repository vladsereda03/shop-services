<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>shop-services</groupId>
  <artifactId>shop</artifactId>
  <version>1.0-SNAPSHOT</version>
  <description>Core components of shop services</description>
  <modules>
    <module>libs/contracts</module>
    <module>services/auth</module>
    <module>services/client</module>
    <module>services/product</module>
    <module>services/cart</module>
    <module>services/order</module>
    <module>services/payment</module>
  </modules>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- stay on the newest 3.5.x patch: the CI Trivy gate fails on fixable
         CRITICALs, and dependency CVE fixes arrive through this version -->
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <packaging>pom</packaging>

  <name>shop-services</name>
  <url/>
  <licenses>
    <license/>
  </licenses>

  <developers>
    <developer>
      <name>Sereda Vladyslav</name>
      <email>vlad.sereda03@gmail.com</email>
    </developer>
  </developers>

  <scm>
    <connection/>
    <developerConnection/>
    <tag/>
    <url/>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- the Boot parent derives maven.compiler.release from this, so source/target
         are deliberately not set: with release in play they would be ignored anyway
         and could only drift out of sync -->
    <java.version>25</java.version>
    <mapstruct.version>1.6.2</mapstruct.version>
    <!-- 1.18.42+ fixes javadoc parsing on JDK 25 -->
    <lombok.version>1.18.46</lombok.version>
    <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    <spotless.version>3.8.0</spotless.version>
    <google-java-format.version>1.35.0</google-java-format.version>
    <resilience4j.version>2.3.0</resilience4j.version>
    <!-- 2.8.x is the springdoc line for Boot 3.5; 3.x requires Boot 4 -->
    <springdoc.version>2.8.17</springdoc.version>
    <jacoco.version>0.8.13</jacoco.version>
    <archunit.version>1.4.1</archunit.version>
    <!-- mutation testing (PIT), wired per-service behind the `pit` profile; report-only.
         1.25.x bundles ASM 9.8+, required to read Java 25 (class file 69) bytecode -->
    <pitest.version>1.25.8</pitest.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>
    <!-- AWS SDK v2 (S3) is not managed by the Boot BOM; only product uses it, for MinIO object storage -->
    <awssdk.version>2.47.4</awssdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
        <optional>true</optional>
      </dependency>
      <dependency>
        <!-- resilience4j versions are not managed by the Boot BOM -->
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-bom</artifactId>
        <version>${resilience4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <!-- AWS SDK v2 S3 client for MinIO object storage (product); not in the Boot BOM -->
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <!-- springdoc versions are not managed by the Boot BOM -->
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <!-- architecture rules (layering, no field injection) run as unit tests.
             Deliberately the core artifact, not archunit-junit5: Surefire 3.5.3+
             silently drops the engine's field-based @ArchTest tests ("Tests run: 0",
             TNG/ArchUnit#1442), so the rules are written as plain JUnit tests -->
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <!-- Mutation testing. Pinned here (version + JUnit 5 test-engine plugin + shared
               config), but only wired into a build by the `pit` profile in the product and
               payment modules — the two services with pure-Mockito unit tests, so PIT runs
               Docker-free. Report-only: no mutation/coverage threshold, so it never fails a build. -->
          <groupId>org.pitest</groupId>
          <artifactId>pitest-maven</artifactId>
          <version>${pitest.version}</version>
          <dependencies>
            <dependency>
              <groupId>org.pitest</groupId>
              <artifactId>pitest-junit5-plugin</artifactId>
              <version>${pitest-junit5.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <!--suppress MavenModelInspection : the org.mockito:mockito-core:jar property is
                generated at build time by maven-dependency-plugin:properties; the IDE cannot
                resolve it statically, but Maven does (same mechanism as the Surefire argLine).
                PIT forks its own minion JVMs and does NOT inherit Surefire's argLine, and the
                service unit tests are pure Mockito, so the minions need the same agent (self-attach
                is deprecated on JDK 25). -->
            <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
            <!-- never pull the Testcontainers integration tests into the mutation run (Docker) -->
            <excludedTestClasses>
              <param>*IT</param>
            </excludedTestClasses>
            <outputFormats>
              <param>HTML</param>
              <param>XML</param>
            </outputFormats>
            <!-- stable output dir (target/pit-reports) for CI artifact upload -->
            <timestampedReports>false</timestampedReports>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok-mapstruct-binding</artifactId>
              <version>${lombok-mapstruct-binding.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <removeUnusedImports/>
            <!-- pinned explicitly: the version Spotless 2.44.5 defaults to calls javac
                 internals whose signature changed in JDK 25 (NoSuchMethodError on
                 Log$DeferredDiagnosticHandler.getDiagnostics) -->
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
          </java>
        </configuration>
      </plugin>

      <plugin>
        <!-- exposes the local-repository path of every dependency as a property named
             groupId:artifactId:type — used for the Mockito agent argument below -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>resolve-dependency-paths</id>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <!-- Mockito is attached as a JVM agent instead of letting it self-attach at
             runtime: self-attaching is deprecated (JDK warns today, a future JDK will
             refuse it). The mockito-core jar is the agent itself — its manifest
             declares Premain-Class.
             @{argLine} is Surefire's late replacement: it expands the argLine property
             at execution time, so the JaCoCo agent that prepare-agent puts there is
             kept instead of being overwritten. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--suppress MavenModelInspection : the org.mockito:mockito-core:jar property is
              generated at build time by maven-dependency-plugin:properties above; the IDE
              cannot resolve it statically, but Maven does (verified: no self-attach warning) -->
          <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
        </configuration>
      </plugin>

      <plugin>
        <!-- integration tests (*IT) run in the integration-test/verify phases, so `mvn test`
             and `mvn package` stay fast and Docker-free; `mvn verify` (and CI) run them -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <!-- coverage: prepare-agent exposes the JaCoCo agent via the argLine
             property, which both Surefire and Failsafe pick up, appending unit
             and integration coverage into one jacoco.exec per module; report
             (declared after failsafe, default phase verify) renders the
             combined HTML/XML into target/site/jacoco -->
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <profiles>
    <!-- End-to-end acceptance tests (tests/e2e), opt-in and excluded from the default reactor.
         They bring the built service images up over real infra with Docker Compose (Testcontainers),
         far heavier than the per-service integration tests, so they never run in a plain
         `mvn verify`. Run them with:  ./mvnw -Pe2e -pl tests/e2e verify  (service images must exist). -->
    <profile>
      <id>e2e</id>
      <modules>
        <module>tests/e2e</module>
      </modules>
    </profile>
  </profiles>

</project>